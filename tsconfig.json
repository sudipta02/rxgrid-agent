{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["lambdas/**/*.ts", "seed/**/*.ts", "stress-test/**/*.ts"],
  "exclude": ["node_modules", "infra", "web"]
}
