{
  "name": "rxgrid-agent",
  "private": true,
  "version": "0.1.0",
  "description": "RxGrid stock-transfer agent on Amazon Bedrock AgentCore harness",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed:dry": "tsx seed/seed-data.ts --dry-run",
    "seed": "tsx seed/seed-data.ts",
    "seed:users": "tsx seed/seed-users.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1176.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
